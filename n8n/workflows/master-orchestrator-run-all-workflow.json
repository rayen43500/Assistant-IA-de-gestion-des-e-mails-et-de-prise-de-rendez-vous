{
  "id": "MasterRunAll0001",
  "name": "0. Test de bout en bout (santé + 4 scénarios)",
  "nodes": [
    {
      "parameters": {},
      "name": "Test manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL || 'http://localhost:5000' }}/health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.INTERNAL_API_KEY || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Santé backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "Scénarios-0",
              "name": "scenarios",
              "value": "={{ [1, 2, 3, 4] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "name": "Scénarios",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "scenarios",
        "options": {}
      },
      "name": "Un scénario",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL || 'http://localhost:5000' }}/api/emails/simulate-scenario",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.INTERNAL_API_KEY || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scenarioNumber: $json.scenarios }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Simuler le scénario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "Bilan-0",
              "name": "scenario",
              "value": "={{ $json.scenarioDescription }}",
              "type": "string"
            },
            {
              "id": "Bilan-1",
              "name": "decision",
              "value": "={{ $json.decision }}",
              "type": "string"
            },
            {
              "id": "Bilan-2",
              "name": "praticien",
              "value": "={{ $json.practitioner?.name || '—' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Bilan",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        100
      ]
    }
  ],
  "connections": {
    "Test manuel": {
      "main": [
        [
          {
            "node": "Santé backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Santé backend": {
      "main": [
        [
          {
            "node": "Scénarios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scénarios": {
      "main": [
        [
          {
            "node": "Un scénario",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Un scénario": {
      "main": [
        [
          {
            "node": "Simuler le scénario",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Simuler le scénario": {
      "main": [
        [
          {
            "node": "Bilan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Tunis",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true,
    "description": "Vérifie que le backend répond et exécute les 4 scénarios (sans envoi réel)."
  }
}
