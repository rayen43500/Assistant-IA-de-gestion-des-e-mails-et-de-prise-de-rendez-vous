{
  "name": "2. Rappels Automatiques 24h Avant RDV (Gmail Garanti + WhatsApp Optionnel)",
  "nodes": [
    {
      "parameters": {},
      "name": "Quand on clique sur 'Tester'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [180, 160]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "name": "Cron Quotidien (08h00 Tunis)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 320]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-reminders",
        "options": {}
      },
      "name": "Webhook Déclenchement Manuel Test",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [180, 480]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/appointments/reminders-due",
        "method": "GET",
        "options": {}
      },
      "name": "Récupérer RDV du Lendemain non rappelés",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 320]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "name": "Itérer sur chaque Patient",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 2.1,
      "position": [680, 320]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/appointments/send-reminder",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"appointmentId\": \"{{ $json._id || 'mock_app_1' }}\",\n  \"patient\": {\n    \"name\": \"{{ $json.patient?.name || 'Patient' }}\",\n    \"email\": \"{{ $json.patient?.email || 'patient@example.tn' }}\",\n    \"phone\": \"{{ $json.patient?.phone || '+216 98 456 789' }}\"\n  },\n  \"date\": \"{{ $json.date || 'demain' }}\",\n  \"timeSlot\": {\n    \"start\": \"{{ $json.timeSlot?.start || '09:30' }}\"\n  }\n}"
      },
      "name": "1. Envoyer Rappel E-mail (Gmail Prioritaire)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [920, 320]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/integrations/whatsapp/send-notification",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"APPOINTMENT_REMINDER_24H\",\n  \"recipient\": \"{{ $json.email?.recipient || '+216 98 456 789' }}\",\n  \"message\": \"👋 Rappel consultation cabinet Dr. Rayen B. prévu demain. (Notification WhatsApp Optionnelle)\"\n}"
      },
      "name": "2. Notification WhatsApp (Optionnelle)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "onError": "continueRegularOutput",
      "position": [1160, 320]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/appointments/mock_app_1/reminder-sent",
        "method": "POST",
        "options": {}
      },
      "name": "3. Consigner Rappel Envoyé dans l'Agenda",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 320]
    }
  ],
  "connections": {
    "Quand on clique sur 'Tester'": {
      "main": [
        [
          {
            "node": "Récupérer RDV du Lendemain non rappelés",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cron Quotidien (08h00 Tunis)": {
      "main": [
        [
          {
            "node": "Récupérer RDV du Lendemain non rappelés",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Déclenchement Manuel Test": {
      "main": [
        [
          {
            "node": "Récupérer RDV du Lendemain non rappelés",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Récupérer RDV du Lendemain non rappelés": {
      "main": [
        [
          {
            "node": "Itérer sur chaque Patient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Itérer sur chaque Patient": {
      "main": [
        [
          {
            "node": "1. Envoyer Rappel E-mail (Gmail Prioritaire)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Envoyer Rappel E-mail (Gmail Prioritaire)": {
      "main": [
        [
          {
            "node": "2. Notification WhatsApp (Optionnelle)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Notification WhatsApp (Optionnelle)": {
      "main": [
        [
          {
            "node": "3. Consigner Rappel Envoyé dans l'Agenda",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
