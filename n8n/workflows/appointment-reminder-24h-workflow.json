{
  "name": "2. Rappel Automatique de Rendez-vous WhatsApp 24h Avant",
  "nodes": [
    {
      "parameters": {},
      "name": "Quand on clique sur 'Tester'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [180, 160]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "name": "Cron Quotidien (08h00 Tunis)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 320]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-reminders",
        "options": {}
      },
      "name": "Webhook Déclenchement Manuel Test",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [180, 480]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/appointments/reminders-due",
        "method": "GET",
        "options": {}
      },
      "name": "Récupérer RDV du Lendemain non rappelés",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 320]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "name": "Itérer sur chaque Patient",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 2.1,
      "position": [680, 320]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/integrations/whatsapp/send-notification",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"APPOINTMENT_REMINDER_24H\",\n  \"recipient\": \"{{ $json.patient?.phone || '+216 98 456 789' }}\",\n  \"message\": \"👋 Bonjour {{ $json.patient?.name || 'Patient' }}, rappel de votre consultation prévue demain à {{ $json.timeSlot?.start || '10:00' }} au cabinet Dr. Rayen B. Répondez OUI pour confirmer.\"\n}"
      },
      "name": "Envoyer Rappel WhatsApp Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [920, 320]
    }
  ],
  "connections": {
    "Quand on clique sur 'Tester'": {
      "main": [
        [
          {
            "node": "Récupérer RDV du Lendemain non rappelés",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cron Quotidien (08h00 Tunis)": {
      "main": [
        [
          {
            "node": "Récupérer RDV du Lendemain non rappelés",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Déclenchement Manuel Test": {
      "main": [
        [
          {
            "node": "Récupérer RDV du Lendemain non rappelés",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Récupérer RDV du Lendemain non rappelés": {
      "main": [
        [
          {
            "node": "Itérer sur chaque Patient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Itérer sur chaque Patient": {
      "main": [
        [
          {
            "node": "Envoyer Rappel WhatsApp Patient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
