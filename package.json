{
  "name": "ai-cabinet-assistant-suite",
  "version": "1.0.0",
  "type": "module",
  "description": "Assistant IA de gestion des e-mails et de prise de rendez-vous pour cabinets médicaux et juridiques (Tunisie 2026)",
  "private": true,
  "scripts": {
    "start": "node scripts/runner.js",
    "start:all": "node scripts/runner.js",
    "start:ai": "node ai-service/server.js",
    "start:n8n": "node n8n/server.js",
    "start:backend": "node backend/src/index.js",
    "start:frontend": "npm --prefix frontend run dev",
    "check:health": "node scripts/check-health.js",
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:backend": "npm --prefix backend run test",
    "health:ai": "curl http://localhost:8000/health",
    "health:backend": "curl http://localhost:5000/health",
    "test:quality": "node quality/run-all.js",
    "test:quality:setup": "npm ci --prefix backend && npm ci --prefix frontend && npm ci --prefix quality && cd quality && npx playwright install chromium firefox",
    "test:unit": "node quality/run-all.js unit",
    "test:api": "node quality/run-all.js api",
    "test:e2e": "node quality/run-all.js e2e",
    "test:perf": "node quality/run-all.js perf",
    "test:security": "node quality/run-all.js lint sca sast dast"
  },
  "keywords": [
    "saas",
    "ai",
    "deep-learning",
    "rag",
    "fastapi",
    "express",
    "react",
    "n8n",
    "devsecops",
    "tunisie"
  ],
  "author": "Équipe Projet SaaS IA 2026",
  "license": "MIT"
}
