        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.INTERNAL_API_KEY || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ emailId: $json._id, patient: $json.sender, subject: $json.subject, excerpt: ($json.body || '').slice(0, 300) }) }}",
        "options": {
          "timeout": 30000
        }
      },
