# ========================================================
# MediLawAI Backend - Variables d'Environnement
# ========================================================

PORT=5000
NODE_ENV=production

# Base de données MongoDB (Locale ou Cloud MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/ai_cabinet_db

# Clé de signature des Tokens JWT
JWT_SECRET=super_secret_jwt_key_cabinet_ai_2026

# URL du Microservice IA Python FastAPI
AI_SERVICE_URL=http://localhost:8000

# Limite de requêtes (Rate Limiting)
RATE_LIMIT_MAX=150

# Origine Frontend autorisée (CORS)
CORS_ORIGIN=*

# ========================================================
# Boîte e-mail centrale (Gmail) — lecture + réponses automatiques
# ========================================================
# Créez un client OAuth "Application Web" dans Google Cloud Console,
# activez l'API Gmail et l'API Calendar, et ajoutez l'URI de redirection ci-dessous.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
FRONTEND_URL=http://localhost:5173

# Clé de chiffrement des jetons OAuth (AES-256-GCM). Ne plus la changer une fois Gmail connecté.
ENCRYPTION_MASTER_KEY=

# Adresse de la boîte centrale (par défaut : le compte Google connecté).
# Écrire à cette adresse n'identifie AUCUN praticien → l'IA demande au patient de préciser.
# CENTRAL_INBOX_EMAIL=contact@medilawai.com
# CENTRAL_INBOX_ALIASES=rdv@medilawai.com,secretariat@medilawai.com

# auto = réponses envoyées automatiquement (confirmation, clarification, créneaux, urgence)
# hitl = toutes les réponses restent en brouillon jusqu'à validation humaine
AUTO_REPLY_MODE=auto
# Les e-mails reçus via POST /api/emails/ingest (n8n) sont-ils répondus automatiquement ?
AUTO_SEND_INGEST=false
# EMAIL_SENDING_DISABLED=true   # coupe tout envoi réel (tests)
# GMAIL_POLL_INTERVAL_MS=30000
# GMAIL_POLL_QUERY=in:inbox is:unread -from:me newer_than:3d

# Fuseau du cabinet (créneaux, "demain", "jeudi")
CABINET_TIMEZONE=Africa/Tunis

# n8n : URL de base des webhooks de production (événements envoyés par le backend)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# N8N_NOTIFY_DISABLED=true
AI_SERVICE_TIMEOUT_MS=5000

# ========================================================
# Sécurité production (OBLIGATOIRES si NODE_ENV=production)
# ========================================================
# JWT_SECRET : longue chaîne aléatoire (ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# INTERNAL_API_KEY : clé partagée backend <-> n8n (même valeur dans l'environnement de n8n)
INTERNAL_API_KEY=
# Origines autorisées (séparées par des virgules)
# CORS_ORIGIN=https://app.mondomaine.tn
# ALLOW_DEMO_TOKENS=false
