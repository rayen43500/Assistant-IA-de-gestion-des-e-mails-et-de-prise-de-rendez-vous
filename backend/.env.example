# ========================================================
# MediLawAI Backend - Variables d'Environnement
# ========================================================

PORT=5000
NODE_ENV=production

# Base de données MongoDB (Locale ou Cloud MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/ai_cabinet_db

# Clé de signature des Tokens JWT
JWT_SECRET=super_secret_jwt_key_cabinet_ai_2026

# URL du Microservice IA Python FastAPI
AI_SERVICE_URL=http://localhost:8000

# Limite de requêtes (Rate Limiting)
RATE_LIMIT_MAX=150

# Origine Frontend autorisée (CORS)
CORS_ORIGIN=*
